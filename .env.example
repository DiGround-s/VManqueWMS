DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vmanque_wms?schema=public"
# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET="change-me"

# Optional: key for secrets stored in the DB (marketplace tokens). Defaults to one derived from SESSION_SECRET.
# INTEGRATIONS_KEY=""

# Mercado Libre app (developers.mercadolibre.cl → Mis aplicaciones). Lab simulator: see ml-sim/README.md
ML_API_URL="https://api.mercadolibre.com"
ML_AUTH_URL="https://auth.mercadolibre.cl/authorization"
ML_CLIENT_ID=""
ML_CLIENT_SECRET=""
ML_REDIRECT_URI="https://tu-dominio/api/integraciones/mercadolibre/callback"

# Public base URL of this app (used for the webhook URLs registered with the stores)
APP_PUBLIC_URL="https://tu-dominio"
# Other stores. Empty = official URLs. Lab simulator: tiendas-sim/README.md
# FALABELLA_API_URL=""   WALMART_API_URL=""   PARIS_API_URL=""   HITES_API_URL=""
# Polling interval for stores without webhooks (seconds, 0 = off) and key for the internal scheduled call
# STORE_POLL_SECONDS=60
# CRON_SECRET=""
